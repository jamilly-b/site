{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/event/:path*",
      "destination": "/event/index.html"
    },
    {
      "source": "/u/:path*",
      "destination": "/u/index.html"
    }
    {
      "source": "/mapa",
      "destination": "https://zone-mapa-web.jamillybraga03.workers.dev/"
    },
    {
      "source": "/mapa/assets/:path*",
      "destination": "https://zone-mapa-web.jamillybraga03.workers.dev/assets/:path*"
    },
    {
      "source": "/event/:path*",
      "destination": "https://zone-mapa-web.jamillybraga03.workers.dev/event/:path*"
    }
  ]
}
